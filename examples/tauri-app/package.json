{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:ios": "tauri ios dev",
    "tauri:dev:android": "tauri android dev",
    "format": "prettier --write 'src/**/*.{js,svelte}' && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check 'src/**/*.{js,svelte}' && cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint src/ && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:fix": "eslint --fix src/ && cargo clippy --fix --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "tauri-plugin-nostr-api": "file:../../"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0"
  }
}
